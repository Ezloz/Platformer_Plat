            <ui:Button text="Play" name="Play" style="-unity-font-style: bold; -unity-text-align: middle-center; width: 146px;"/>
            <ui:Button text="Controls" name="Controls" style="-unity-font-style: bold; width: 143px;"/>
            <ui:Button text="Quit" name="Quit" style="-unity-font-style: bold; width: 143px;"/>
