
.controls-screen {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: rgb(35, 38, 43);
    justify-content: center;
    align-items: center;
    padding: 2%;
}

.title {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(235, 230, 215);
    margin-bottom: 20px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.controls-panel {
    width: 65%;
    max-width: 700px;
    min-width: 320px;
    background-color: rgb(44, 48, 54);
    padding: 12px;
    flex-shrink: 1;
}

.header-row {
    flex-direction: row;
    align-items: center;
    padding-bottom: 8px;
    margin-bottom: 3px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(90, 94, 100);
}

.header {
    flex-grow: 1;
    flex-shrink: 1;
    color: rgb(150, 155, 160);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: center;
}

.action-column {
    flex-grow: 0;
    flex-shrink: 0;
    width: 25%;
    -unity-text-align: left;
}

.control-row {
    flex-direction: row;
    align-items: center;
    min-height: 42px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(65, 69, 75);
}

.action {
    width: 25%;
    flex-shrink: 0;
    color: rgb(235, 230, 215);
    font-size: 14px;
    -unity-font-style: bold;
}

.key {
    flex-grow: 1;
    flex-shrink: 1;
    color: rgb(210, 210, 205);
    font-size: 13px;
    -unity-text-align: center;
}

.back-button {
    width: 120px;
    height: 34px;
    margin-top: 20px;
    flex-shrink: 0;
    background-color: rgb(52, 56, 62);
    color: rgb(235, 230, 215);
    border-radius: 2px;
    border-width: 0;
    -unity-font-style: bold;
}

.back-button:hover {
    background-color: rgb(75, 80, 87);
}
