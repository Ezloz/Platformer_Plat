
.main-menu {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: rgb(35, 38, 43);
}

.title {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(235, 230, 215);
    -unity-text-align: middle-center;
    margin-bottom: 35px;
}

.menu-buttons {
    width: 180px;
    align-items: stretch;
}

.menu-button {
    height: 42px;
    margin-bottom: 8px;
    background-color: rgb(52, 56, 62);
    color: rgb(225, 225, 220);
    font-size: 16px;
    border-width: 0;
    border-radius: 2px;
}

.menu-button:hover {
    background-color: rgb(75, 80, 87);
    color: white;
}

.menu-button:focus {
    background-color: rgb(90, 96, 104);
    color: white;
    border-color: rgb(235, 230, 215);
    border-width: 1px;
}
